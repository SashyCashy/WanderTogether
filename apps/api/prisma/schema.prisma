// WanderTogether — Prisma schema
//
// AD-4: this file is the sole source of truth for every entity below.
// No slice defines a competing table or duplicated shape for a concept
// another slice already owns.
//
// AD-5: authored whole, upfront, covering all 7 entities across all 5
// features — not built up piecemeal per-slice.
//
// Ids: every entity id is generated by calling `nanoid()` with no
// arguments (its default length) in application code — never a Prisma
// `@default()` (Prisma has no built-in nanoid default), never
// auto-increment. Trip is the one exception: its `id` doubles as the
// Trip Code (AD-2/AD-3), generated with `nanoid(10)` — a minimum of 10
// characters, URL-safe, non-sequential.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

/// A static, curated catalog entry (place + short description) that can
/// be browsed and used to start a Trip. Seed-only (AD-12) — no endpoint
/// creates a Destination at runtime.
model Destination {
  id          String   @id
  /// Stable natural key used by the seed script to upsert idempotently.
  slug        String   @unique
  name        String
  country     String
  /// Coarse filter used by FR-1 (e.g. "Southern Europe").
  region      String
  /// Coarse filter used by FR-1 (e.g. "city", "beach", "adventure").
  tripType    String
  description String
  photoUrl    String
  createdAt   DateTime @default(now())

  trips                   Trip[]
  accommodationListings   AccommodationListing[]
  writeUps                TripWriteup[]
}

/// A planned trip created by one user, holding a destination, dates, an
/// itinerary, members, and (optionally) an attached accommodation
/// listing. `id` doubles as the Trip Code/Link (AD-2, AD-3) — the sole
/// access control for every Trip-scoped endpoint.
model Trip {
  id                       String   @id
  name                     String
  destinationId            String
  startDate                DateTime?
  endDate                  DateTime?
  /// FR-7: whether this Trip is currently listed on the Buddies surface.
  openToBuddies            Boolean  @default(false)
  /// Shown alongside the Trip on the Buddies surface once open.
  buddyNote                String?
  /// 0..1 attached Accommodation (AD-8: PATCH-partial-merge field, not
  /// itinerary's full-overwrite semantics).
  attachedAccommodationId  String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  destination            Destination           @relation(fields: [destinationId], references: [id])
  attachedAccommodation  AccommodationListing?  @relation(fields: [attachedAccommodationId], references: [id])
  members                TripMember[]
  itineraryItems         ItineraryItem[]
  buddyRequests          TravelBuddyRequest[]

  @@index([destinationId])
  @@index([attachedAccommodationId])
}

/// A persisted membership record for a Trip. AD-6: created via one shared
/// `trips.addMember(tripCode, displayName)` function — both a direct
/// Traveler Profile submission and a buddy-request accept go through it,
/// so "member" is never an ephemeral, client-only concept.
model TripMember {
  id          String   @id
  tripId      String
  displayName String
  joinedAt    DateTime @default(now())

  trip Trip @relation(fields: [tripId], references: [id])

  @@index([tripId])
}

/// One line of a Trip's shared itinerary (day, title, note). AD-8:
/// itinerary writes are full-resource overwrites, not per-line
/// optimistic-lock/PATCH — that rule lives in the trips service, not here.
model ItineraryItem {
  id        String   @id
  tripId    String
  /// Free-form day label (e.g. "Day 1") — itinerary structure beyond a
  /// flat list is explicitly deferred (see ARCHITECTURE-SPINE.md > Deferred).
  day       String
  title     String
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trip Trip @relation(fields: [tripId], references: [id])

  @@index([tripId])
}

/// A request from a person outside a Trip to join it, submitted against
/// a Trip marked open to buddies (FR-8). AD-14: de-duplication of "one
/// request per person per Trip" is client-side only — no unique
/// constraint here on purpose.
model TravelBuddyRequest {
  id             String   @id
  tripId         String
  requesterName  String
  message        String?
  /// One of "pending" | "accepted" | "declined".
  status         String   @default("pending")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  trip Trip @relation(fields: [tripId], references: [id])

  @@index([tripId])
}

/// A text-plus-photo post about a past trip experience, optionally linked
/// to a Destination (FR-10, FR-11).
model TripWriteup {
  id            String   @id
  title         String
  body          String
  /// AD-11: relative URL path strings for photos written to
  /// apps/api/uploads/ via multer — a JSON array, never base64-in-SQLite
  /// and never a separate Photo entity.
  photoUrls     Json     @default("[]")
  authorName    String?
  destinationId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  destination Destination? @relation(fields: [destinationId], references: [id])

  @@index([destinationId])
}

/// A static/mock hotel or hostel entry that can be browsed and attached
/// to a Trip (FR-12, FR-13). Seed-only (AD-12), shape from the PRD
/// addendum — no admin/create endpoint exists for this at runtime.
model AccommodationListing {
  id                String   @id
  /// Stable natural key used by the seed script to upsert idempotently.
  slug              String   @unique
  name              String
  destinationId     String
  /// "hotel" | "hostel".
  type              String
  pricePerNightUSD  Int
  rating            Float
  photoUrl          String
  description       String
  createdAt         DateTime @default(now())

  destination     Destination @relation(fields: [destinationId], references: [id])
  attachedToTrips  Trip[]

  @@index([destinationId])
}
