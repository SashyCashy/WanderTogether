{
  "name": "wandertogether",
  "private": true,
  "version": "0.0.0",
  "description": "WanderTogether monorepo — npm workspaces for apps/web (Vite + React) and apps/api (Express).",
  "workspaces": [
    "apps/web",
    "apps/api"
  ],
  "engines": {
    "node": "^24.0"
  },
  "scripts": {
    "dev:web": "npm run dev --workspace apps/web",
    "dev:api": "npm run dev --workspace apps/api",
    "build": "npm run build --workspaces --if-present"
  }
}
